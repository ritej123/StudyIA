# =============================================================================
# StudyAI — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# NE JAMAIS committer .env dans Git !
# =============================================================================

# --- Base de données PostgreSQL ---
POSTGRES_DB=studyai
POSTGRES_USER=studyai
POSTGRES_PASSWORD=ritej

# --- Backend Spring Boot ---
# JWT Secret (minimum 256 bits / 32 caractères)
JWT_SECRET=uwM45UKWBsSIsGO6paZiXbEVgaqaIuGVOk9b6z03vFo=
# Durée de validité de l'access token (millisecondes) — 900000 = 15 minutes
JWT_EXPIRATION_MS=900000
# Durée de validité du refresh token (jours)
REFRESH_TOKEN_EXPIRATION_DAYS=7
# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:4200

# --- Service IA (FastAPI) ---
# Clé API Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Modèle Gemini à utiliser
GEMINI_MODEL=gemini-1.5-flash
